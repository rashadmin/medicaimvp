import time
def embed_documents(documents: list[str], batch_size: int = 30) -> list[list[float]]:
    """Embed a list of documents using Gemini Embedding 001 via LangChain."""
    embeddings = GoogleGenerativeAIEmbeddings(
        model="models/gemini-embedding-001",
        task_type="retrieval_document",
        google_api_key="AIzaSyDCFBob89PbQCJ8cLu8hiCsLoFHyDBPrTo"  # or set GOOGLE_API_KEY env var
    )

    all_embeddings = []
    total_batches = (len(documents) + batch_size - 1) // batch_size
    for i in range(0, len(documents), batch_size):
        batch = documents[i : i + batch_size]
        try:
            batch_embeddings = embeddings.embed_documents(batch)
            all_embeddings.extend(batch_embeddings)
            print(f"✅ Embedded {min(i + batch_size, len(documents))} / {len(documents)} docs")

        except Exception as e:
            print(f"❌ Error at batch {i // batch_size + 1}: {e}")
            print("⏳ Waiting 60s before retrying...")
            time.sleep(60)
            # retry once
            batch_embeddings = embeddings.embed_documents(batch)
            all_embeddings.extend(batch_embeddings)

        # wait between batches to respect 30k token/min limit
        # 20 docs * 1300 tokens = 26,000 tokens → wait ~60s before next batch
        if i + batch_size < len(documents):
            print(f"⏳ Rate limit pause... (batch {i // batch_size + 1}/{total_batches})")
            time.sleep(62)  # just over 60s to be safe
        
    return all_embeddings


